params {

    // required
    samplesheet = null
    host_reference = "${projectDir}/references/GRCh38.p14.genome.fa"
    sample_type = null
    
    // Flags
    read_type = 'se'
    publish_host_bam = true
    skip_host_mapping = false

    // TRIMMING
    trimmer = 'trim_galore'
    trim_length     = 30
    trim_quality    = 33
    min_overlap = 30

    // HOST DNA MAPPING
    map_quality     = 30
    map_missing_prob = 0.01
    chunk_size      = 20000000 // 20 million reads per mapping job
    seed_length = 1024
    gap_fraction = 2
    filter_ribo = false

    // RNA SPECIFIC MAPPING
    ncRNA_mapper = 'bowtie2'
    RNA_host_mapper = 'bowtie2'
    ribo_bwa_ref = "${projectDir}/references/rRNA.fa"
    trna_bwa_ref = "${projectDir}/references/hg38-tRNAs.fa"
    hg_star_ref = "${projectDir}/references/STAR_index"
    ribo_bt2_ref = "${projectDir}/references/rRNA.bt2"
    trna_bt2_ref = "${projectDir}/references/hg38-tRNAs"
    bt2_ref = "${projectDir}/references/GRCh38.p14.genome.bt2"
    rrna_bed = "${projectDir}/references/rmsk_annot_rRNA.bed"
    dsRNA_bed = "${projectDir}/references/dsRNA_RNAduplex_sort.bed"
    hg_gtf = "${projectDir}/references/gencode.v49.chr_patch_hapl_scaff.annotation.withrmsk.gtf"
    bwa_mapq = 20 // double check this to make it comparable
    bt2_mapq = 20
    STAR_mapq = 20
    strand = 0
    max_hits = 100
    multi = false

    // TAXONOMIC PROFILING
    kraken2_db      = "/shared/biodata/microbiome/kraken2/k2_standard_20230605"
    bracken_read_len = 100
    bracken_tax_level = 'S'
    krona_min_fraction = 0.5

    // ASSEMBLY
    assembly_tool = 'megahit'

}

process {

    withLabel: demand_1 {
        cpus = 1
        memory = 8.GB
    }

    withLabel: demand_2 {
        cpus = 2
        memory = 16.GB
    }

    withLabel: demand_3 {
        cpus = 4
        memory = 32.GB
    }

    withLabel: demand_4 {
        cpus = 8
        memory = 64.GB
    }

    withLabel: demand_5 {
        cpus = 16
        memory = 128.GB
    }

    withLabel: demand_6 {
        cpus = 32
        memory = 200.GB
    }

}

profiles {
    test {
        process.time = '1d'
        params {
            host_reference  = "${projectDir}/references/test/chr1.fa"
            hg_star_ref = "${projectDir}/references/test/STAR_index"
            bt2_ref = "${projectDir}/references/test/chr1.bt2"
        }
    }
}
